# Check out text with LF on every platform so scripts run on Linux hosts and MANIFEST.sha256 verifies everywhere.
* text=auto eol=lf
*.png binary
*.jpg binary
*.ttf binary
*.zip binary
*.tar binary
# the OKF knowledge bundle is hash-pinned (ADR-054): its bytes must not change with the platform
backend/src/main/resources/okf/** text eol=lf
