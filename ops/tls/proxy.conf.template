# TMRKZ https entry point (owner, 11 Nov 2026; ADR-051), as TNQL's tools/offline_release/proxy/mover.conf.template:
# the server certificate issued by the organisation's internal CA is held here and every request is passed to the web
# entry point. Rendered by the nginx image at start (envsubst of ${TMRKZ_HTTPS_PORT}); runs only with COMPOSE_PROFILES=tls.

# plain http only redirects to https
server {
    listen 8080;
    server_name _;
    server_tokens off;
    return 301 https://$host:${TMRKZ_HTTPS_PORT}$request_uri;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name _;
    server_tokens off;

    # server.crt = the issued certificate followed by the issuing CA(s); server.key never leaves this host
    ssl_certificate     /etc/tmrkz-tls/server.crt;
    ssl_certificate_key /etc/tmrkz-tls/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:tmrkz_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 25m;
    proxy_read_timeout 120s;

    location / {
        proxy_pass http://web:80;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port ${TMRKZ_HTTPS_PORT};
        proxy_buffering off;
    }
}
