# TMRKZ synthetic enterprise directory: the Mil* attributes TMRKZ reads (ADR-068/094), as MOVER's test directory added
# MilNumber and MilRankName (same OIDs); single-valued Unicode strings under 1.3.6.1.4.1.99999.77.* — demo only.
# Indexed (searchFlags 1): only the number (unique per user). Measured on 20 Nov 2026: indexing the unit and the main unit
# too makes every add rewrite that unit's index list, and the list grows to hundreds of entries — batch times go from 6s
# to over an hour as users pile up. Without those indexes, batch times stay flat.

dn: CN=MilNumber,CN=Schema,CN=Configuration,DC=tmrkz,DC=test
objectClass: top
objectClass: attributeSchema
attributeID: 1.3.6.1.4.1.99999.77.1
cn: MilNumber
name: MilNumber
lDAPDisplayName: MilNumber
adminDisplayName: MilNumber
attributeSyntax: 2.5.5.12
oMSyntax: 64
isSingleValued: TRUE
searchFlags: 1

