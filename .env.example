# Copy to .env and replace every value. ops/init-env.sh generates random secrets for you.
# Never commit .env.

MOVER_DB_PASSWORD=change-me
# 32+ random characters; keys the internal approval attestation (HMAC). Rotate per docs/OPERATIONS.md.
MOVER_ATTESTATION_KEY=change-me-to-32-or-more-random-characters
MOVER_HTTP_PORT=8088
# Set true when served over TLS by the internal reverse proxy.
MOVER_SECURE_COOKIE=false
# Protects the stored HR source password (TMRKZ's own key).
TMRKZ_HR_SETTINGS_KEY=change-me-to-32-or-more-random-characters
# Address users open (behind the organisation's TLS proxy in production).
TMRKZ_PUBLIC_URL=http://localhost:8088
TMRKZ_OIDC_CLIENT_SECRET=change-me
TMRKZ_KEYCLOAK_DB_PASSWORD=change-me
TMRKZ_KEYCLOAK_ADMIN_PASSWORD=change-me
# TMRKZ's own authorisation service (OpenFGA): database password and preshared API key.
TMRKZ_OPENFGA_DB_PASSWORD=change-me
TMRKZ_OPENFGA_API_TOKEN=change-me-to-32-or-more-random-characters
# Enterprise directory (read-only service account); CA certificates go in ops/keycloak/truststores/.
LDAP_URL=ldaps://directory.example.internal:636
LDAP_START_TLS=false
LDAP_BIND_DN=
LDAP_BIND_CREDENTIAL=
LDAP_USERS_DN=
