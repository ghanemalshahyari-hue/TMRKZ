# Copy to .env and replace every value. ops/init-env.sh generates random secrets for you.
# Never commit .env.

MOVER_DB_PASSWORD=change-me
# 32+ random characters; keys the internal approval attestation (HMAC). Rotate per docs/OPERATIONS.md.
MOVER_ATTESTATION_KEY=change-me-to-32-or-more-random-characters
MOVER_HTTP_PORT=8088
# Set true when served over https (ops/tls/enable.sh sets it).
MOVER_SECURE_COOKIE=false
# Protects the stored HR source password (TMRKZ's own key).
TMRKZ_HR_SETTINGS_KEY=change-me-to-32-or-more-random-characters
# Address users open: https://<name> in production (ops/tls/README.md; ADR-051).
TMRKZ_PUBLIC_URL=http://localhost:8088
# https served by TMRKZ itself, as TNQL (ops/tls/enable.sh sets these): the proxy service runs with COMPOSE_PROFILES=tls,
# the plain port is then reachable from this host only, and the certificate and key live in TMRKZ_TLS_DIR.
#COMPOSE_PROFILES=tls
#MOVER_HTTP_BIND=127.0.0.1
#TMRKZ_HTTPS_PORT=443
#TMRKZ_HTTP_REDIRECT_PORT=80
#TMRKZ_TLS_DIR=./ops/tls/private
TMRKZ_OIDC_CLIENT_SECRET=change-me
TMRKZ_KEYCLOAK_DB_PASSWORD=change-me
TMRKZ_KEYCLOAK_ADMIN_PASSWORD=change-me
# TMRKZ's own authorisation service (OpenFGA): database password and preshared API key.
TMRKZ_OPENFGA_DB_PASSWORD=change-me
TMRKZ_OPENFGA_API_TOKEN=change-me-to-32-or-more-random-characters
# Enterprise directory (read-only service account); CA certificates go in ops/keycloak/truststores/.
LDAP_URL=ldaps://directory.example.internal:636
LDAP_START_TLS=false
LDAP_BIND_DN=
LDAP_BIND_CREDENTIAL=
LDAP_USERS_DN=
# Employment attributes before Oracle is in force (ADR-068): the NAMES of the directory attributes that carry them in this
# organisation (ask its IT). Empty = not read; nothing is assumed. A unit is matched by its Unit ID only (the unit's external
# ID in TMRKZ), never by name, and never created. After changing these, run ops/keycloak/set-employment-attributes.sh so
# the identity provider maps the same attributes, then set the claim names below.
LDAP_ATTR_UNIT_ID=
LDAP_ATTR_UNIT_NAME=
LDAP_ATTR_MAIN_UNIT_ID=
LDAP_ATTR_RANK=
LDAP_ATTR_POSITION=
# The ID-token claims TMRKZ reads for the same values on the automatic sign-in. Empty = not read. The identity provider's
# realm names them tmrkz_unit_id, tmrkz_unit_name, tmrkz_main_unit_id, tmrkz_rank, tmrkz_position.
TMRKZ_OIDC_CLAIM_UNIT_ID=
TMRKZ_OIDC_CLAIM_UNIT_NAME=
TMRKZ_OIDC_CLAIM_MAIN_UNIT_ID=
TMRKZ_OIDC_CLAIM_RANK=
TMRKZ_OIDC_CLAIM_POSITION=
# Offline map root (installed map package, ADR-036): python3 ops/map-package/install_package.py install --package
# <tmrkz-map-*.tar> --root <absolute path> --confirm <same path>. Mounted read-only into the web entry point.
TMRKZ_MAP_ROOT=./map-runtime
# «المساعد الذكي» (ADR-056), as TNQL: an OpenAI-compatible model server (Ollama, llama.cpp server, vLLM…) inside the network.
# Off by default; the guide («دليل تمركز») answers without it. Point the address at the organisation's own server.
#TMRKZ_AI_ENABLED=true
#TMRKZ_AI_BASE_URL=http://model-server.internal:11434/v1
#TMRKZ_AI_MODEL=qwen2.5:7b
#TMRKZ_AI_API_KEY=
